# Copy this file to .env and fill in what you use. Empty = off / default. Lines starting with # are optional.
#
# Who reads it:
# - The command-line tool (npm start, npm run dry, npm run render:test, ...) reads .env on every run.
# - The dashboard (docker compose up -d) copies .env into its database ONCE, on its first start.
#   After that, change settings in the dashboard (Integrations page); edits here are ignored.
# Every key below is read by src/config.js or the server. Keys not listed here are not used.

# ============================================================================
# 1. Required: who writes the scripts, who speaks them
# ============================================================================

# --- Topics and scripts (Claude) ---
# claude-code = your Claude subscription through the Claude Code CLI (no API bill; default)
# api         = Anthropic API key, billed per use
LLM_PROVIDER=claude-code
CLAUDE_MODEL=claude-sonnet-5-5
# Docker / a server only: run `claude setup-token` on a PC and paste the token here or in the dashboard
CLAUDE_CODE_OAUTH_TOKEN=
# Only for LLM_PROVIDER=api
ANTHROPIC_API_KEY=

# --- Voice ---
# auto = ElevenLabs if it has a key, then Google, then the free Edge voice
TTS_PROVIDER=auto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3
# Delivery tags put in front of every line (eleven_v3 only); empty = none
ELEVENLABS_STYLE_TAGS=[confident] [authoritative]
# v3 stability: 0.5 natural (default), 1 robust = steadiest Bangla pronunciation, less expressive
ELEVENLABS_STABILITY=0.5
# Free fallback: edge-tts voice (list: edge-tts --list-voices). Bangla: bn-BD-NabanitaNeural, bn-BD-PradeepNeural
VOICE=bn-BD-NabanitaNeural
TTS_RATE=-4%
# Google Chirp 3 HD (optional third provider)
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=bn-IN-Chirp3-HD-Kore
# Words the voice mispronounces: edit pronunciation.json (no key needed); test with: npm run voice:test -- "বাক্য"

# ============================================================================
# 2. The channel: what the videos are about and how long
# ============================================================================

NICHE=technology and AI tips for beginners
LANGUAGE=Bangla
# shorts = 1080x1920 vertical, landscape = 1920x1080
VIDEO_FORMAT=shorts
# Length of every video in minutes, Shorts included (YouTube counts vertical videos up to 3 minutes as Shorts)
TARGET_MINUTES=1
# idea  = tips / explainer videos (default)
# story = a cartoon parable with one lesson, drawn with the built-in cast (uses the vox-story theme)
SCRIPT_MODE=idea
# Dashboard only: categories a scheduled "make" rule picks from at random. Keep the single quotes.
TOPIC_CATEGORIES='["AI","New tech and inventions","Job loss","Privacy","AI vs humans","Cybersecurity","Tech updates"]'
# Your own website, promoted in every description and on the outro (empty = none)
EXTRA_LINK=

# ============================================================================
# 3. The look
# ============================================================================

# Empty = Claude picks a theme per video (never the same as the last 3). Force one with its id:
#   neon | minimal | news | sunset | gold | pop | glass | hacker       (motion graphics)
#   vox-paper | vox-newsprint | vox-marker | vox-story                (Vox paper look; vox-story = cartoon cast)
#   reel-light | reel-dark                                            (launch-reel look: one accent, hard cuts)
#   ledger | ledger-green                                             (paper explainer: cream/green/red, ink cards; best in landscape)
#   chalkboard | exam-paper | notebook                                (exam looks, only for question videos)
THEME=
# mixed = motion graphics + stock/your footage on some scenes, motion = graphics only, footage = clips on every scene
VISUALS=mixed
# Footage sources, tried in this order: 1. your clips in ./footage, 2. Pixabay (free key: pixabay.com/api/docs), 3. Pexels
PIXABAY_API_KEY=
PEXELS_API_KEY=
# Claude picks each scene's transition / sound cues / camera move / data graphic (false = the theme's fixed behaviour)
DIRECT_TRANSITIONS=true
DIRECT_SFX=true
DIRECT_CAMERA=true
DIRECT_GRAPHICS=true
# Sound effects on transitions and cards
SFX=true
# Thumbnail: empty = Claude picks a style per video; force one: bigText | versus | question | number
THUMB_STYLE=
# The video opens with its thumbnail card (also TikTok's cover frame); false = the plain title card
THUMB_INTRO=true
# Background music: synth = an original track made in code per video (cuts snap to its beat), folder = a file from ./music, none
MUSIC=none
MUSIC_VOLUME=0.12
# Every finished video normalised to -14 LUFS (what the platforms normalise to); false = off
LOUDNESS=true
# Critique loop: Claude scores a contact sheet after each render; under CRITIQUE_MIN it re-renders once with its adjustments
CRITIQUE=true
CRITIQUE_MIN=7
CRITIQUE_ROUNDS=1

# ============================================================================
# 4. Publishing
# ============================================================================

# --- YouTube --- sign-in: client_secret.json + token.json in this folder (npm run auth) or "Connect YouTube" in the dashboard
# private | unlisted | public  (unverified Google apps are forced to private)
PRIVACY_STATUS=private
YT_CATEGORY_ID=28
# Label videos as AI-made ("altered or synthetic content")
SYNTHETIC_MEDIA=true

# --- TikTok (dashboard only; needs a TikTok developer app; unaudited apps can only post SELF_ONLY) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
# SELF_ONLY | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY=SELF_ONLY

# --- Facebook and Instagram (dashboard only; needs a Meta developer app) ---
META_GRAPH_VERSION=v27.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_USER_ID=
# Empty = use the Facebook Page token
INSTAGRAM_ACCESS_TOKEN=

# ============================================================================
# 5. Question videos (exam questions from your own sites) - leave empty unless you use them
# ============================================================================
# QUESTION_SOURCE=
# QUESTION_SUBJECT=all
# QUESTIONS_PER_VIDEO=2

# ============================================================================
# 6. Rarely changed
# ============================================================================
# false = the simpler ffmpeg video instead of the animated Remotion one (captions only)
# USE_REMOTION=true
# Caption font for that ffmpeg fallback (a Bengali font such as Nirmala UI for Bangla)
# CAPTION_FONT=Nirmala UI
# Path to the claude CLI when it is not on PATH (inside Docker it is always "claude")
# CLAUDE_BIN=claude
# Minimum seconds for one Claude call; long scripts get more on their own
# CLAUDE_TIMEOUT_SEC=300

# ============================================================================
# 7. Dashboard without Docker (docker-compose.yml sets these itself)
# ============================================================================
# REDIS_URL=redis://127.0.0.1:6379
# PORT=7000
# PUBLIC_URL=http://localhost:7000
# Without a password the dashboard has no login: it listens on this PC only (127.0.0.1) unless you set
# HOST=0.0.0.0, which lets every device on your network change settings and publish.
# HOST=127.0.0.1

# ============================================================================
# 8. SERVER ONLY (docs/deploy.md). Do not put these in a Windows/Mac .env.
# ============================================================================
# The domain Caddy serves with HTTPS, and the public URL the OAuth callbacks use
# DOMAIN=studio.example.com
# PUBLIC_URL=https://studio.example.com
# One shared password (8+ characters). Required when PUBLIC_URL is not localhost. Changing it signs everyone out.
# DASHBOARD_PASSWORD=
# Behind a reverse proxy (Caddy, nginx, Cloudflare): 1 reads the visitor's real address from X-Forwarded-For
# TRUST_PROXY=1
# Chrome on a VM without a GPU. On a Windows/Mac PC this is software rendering, ~10x slower: leave it unset there.
# REMOTION_GL=swangle
# Threads one render may use (3 on a 4-vCPU VM keeps the dashboard responsive)
# REMOTION_CONCURRENCY=3
# MB of footage frames the compositor may cache; raise only if the worker's memory limit allows it
# REMOTION_VIDEO_CACHE_MB=512
# Cloudflare R2 as the video store (10 GB free, no egress fees); local = keep videos in ./output
# STORAGE=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PREFIX=
# R2_KEEP_DAYS=3
