# Copy this file to .env and fill in what you use. Empty = off / default.
#
# Who reads it:
# - The command-line tool (npm start, npm run render:test, ...) reads .env on every run.
# - The dashboard (docker compose up -d) copies .env into its database ONCE, on its first start.
#   After that, change settings in the dashboard (Integrations page); edits here are ignored.

# --- AI: topics and scripts ---
# claude-code = your Claude subscription through the Claude Code CLI (no API bill)
# api         = Anthropic API key, billed per use
LLM_PROVIDER=claude-code
CLAUDE_MODEL=claude-sonnet-5-5
# Path to the claude CLI. Inside Docker it is always "claude", whatever you put here.
CLAUDE_BIN=claude
CLAUDE_TIMEOUT_SEC=300
# Docker only: run `claude setup-token` and paste the token here or in the dashboard.
CLAUDE_CODE_OAUTH_TOKEN=
# Only for LLM_PROVIDER=api
ANTHROPIC_API_KEY=

# --- Voice ---
# auto = ElevenLabs if it has a key, then Google, then free Edge voices
TTS_PROVIDER=auto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3
# Delivery tags put in front of every line (eleven_v3 only)
ELEVENLABS_STYLE_TAGS=[confident] [authoritative]
# Free fallback: edge-tts voice (list all with: edge-tts --list-voices) and speed
VOICE=en-US-AndrewNeural
TTS_RATE=-4%
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=bn-IN-Chirp3-HD-Kore

# --- Visuals ---
# Footage is tried in this order:
# 1. Your own clips: drop .mp4/.mov files into ./footage (the filename words are matched to scenes)
# 2. Pixabay (free, instant key): https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# 3. Pexels (only if you already have a key; new keys are currently paused)
PEXELS_API_KEY=
# With none of these, scenes use an animated background.
# mixed = footage + motion graphics, motion = graphics only, footage = clips only
VISUALS=mixed
# true = animated Remotion video, false = simpler ffmpeg video
USE_REMOTION=true
# neon | minimal | news | sunset | gold | pop | glass | hacker  (empty = Claude picks per video)
# Vox-style explainer looks (paper cutouts, stepped stop-motion, marker highlights):
#   vox-paper | vox-newsprint | vox-marker
THEME=
SFX=true
# Claude picks each scene's transition / sound cues / camera move (false = the theme's fixed behaviour)
DIRECT_TRANSITIONS=true
DIRECT_SFX=true
DIRECT_CAMERA=true
# Caption font for the ffmpeg fallback (use a Bengali font such as Nirmala UI for Bangla)
CAPTION_FONT=DejaVu Sans

# --- Channel / content ---
NICHE=technology and AI tips for beginners
LANGUAGE=English
# shorts = 1080x1920 vertical, landscape = 1920x1080
VIDEO_FORMAT=shorts
# Length of landscape videos, in minutes
TARGET_MINUTES=3
# Dashboard only: categories a scheduled "make" rule picks from at random. Keep the single quotes.
TOPIC_CATEGORIES='["AI","New tech and inventions","Job loss","Privacy","AI vs humans","Cybersecurity","Tech updates"]'

# --- YouTube ---
# private | unlisted | public  (unverified API projects are forced to private)
PRIVACY_STATUS=private
YT_CATEGORY_ID=28
# Label videos as AI-made ("altered or synthetic content")
SYNTHETIC_MEDIA=true
# Sign-in comes from client_secret.json and token.json in this folder (npm run auth),
# or from "Connect YouTube" in the dashboard.

# --- TikTok (dashboard only; needs a TikTok developer app) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
# Unaudited apps can only post SELF_ONLY.
# SELF_ONLY | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY=SELF_ONLY

# --- Facebook and Instagram (dashboard only; needs a Meta developer app) ---
META_GRAPH_VERSION=v27.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_USER_ID=
# Empty = use the Facebook Page token
INSTAGRAM_ACCESS_TOKEN=

# --- Running the dashboard without Docker (docker-compose.yml sets these itself) ---
# REDIS_URL=redis://127.0.0.1:6379
# PORT=7000
# PUBLIC_URL=http://localhost:7000
# The dashboard has no login. It listens on this PC only (127.0.0.1) unless you set HOST=0.0.0.0,
# which lets every device on your network change settings and publish.
# HOST=127.0.0.1
