# --- AI (topics + script) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# --- Stock footage (all optional; tried in this order) ---
# 1. Your own clips: drop .mp4/.mov files into ./footage
# 2. Pixabay (free, instant key): https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# 3. Pexels (only if you already have a key; new keys are currently paused)
PEXELS_API_KEY=
# With none of these, scenes use an animated gradient background.

# --- Channel / content settings ---
NICHE=technology and AI tips for beginners
LANGUAGE=English
# edge-tts voice, list all with: edge-tts --list-voices
VOICE=en-US-AndrewNeural
# 16:9 long video = landscape, Shorts = portrait
VIDEO_FORMAT=portrait
TARGET_MINUTES=1

# --- YouTube ---
# private | unlisted | public  (unverified API projects are forced to private)
PRIVACY_STATUS=private
YT_CATEGORY_ID=28
