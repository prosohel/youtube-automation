{
  "name": "yt-automation",
  "version": "1.0.0",
  "description": "AI pipeline: topic finding -> script -> voice -> video -> YouTube upload",
  "license": "MIT",
  "author": "SH SOHEL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prosohel/youtube-automation.git"
  },
  "bugs": {
    "url": "https://github.com/prosohel/youtube-automation/issues"
  },
  "homepage": "https://github.com/prosohel/youtube-automation#readme",
  "keywords": [
    "youtube",
    "youtube-automation",
    "youtube-shorts",
    "tiktok",
    "instagram-reels",
    "ai-video",
    "video-generation",
    "remotion",
    "claude",
    "text-to-speech",
    "bullmq",
    "self-hosted"
  ],
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "auth": "node src/auth.js",
    "topics": "node src/index.js --only=topics",
    "dry": "node src/index.js --no-upload",
    "render:test": "node src/dev-render.js",
    "render:gallery": "node src/dev-gallery.js",
    "render:thumbs": "node src/dev-thumbs.js",
    "questions:dry": "node src/dev-questions.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:redis": "docker run -d --rm --name yt-test-redis -p 127.0.0.1:6380:6379 redis:7-alpine",
    "web": "node server/api.js",
    "worker": "node server/worker.js",
    "voice:test": "node src/voice-test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@react-three/fiber": "9.1.2",
    "@remotion/animated-emoji": "4.0.540",
    "@remotion/bundler": "4.0.540",
    "@remotion/google-fonts": "4.0.540",
    "@remotion/light-leaks": "4.0.540",
    "@remotion/lottie": "4.0.540",
    "@remotion/motion-blur": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@remotion/sfx": "4.0.540",
    "@remotion/three": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "bullmq": "6.7.0",
    "cron-parser": "5.10.3",
    "dotenv": "^18.0.9",
    "express": "5.3.0",
    "googleapis": "^189.0.0",
    "ioredis": "6.0.0",
    "katex": "0.16.9",
    "lucide-react": "^1.70.0",
    "node-html-parser": "6.1.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.540",
    "three": "0.170.0"
  },
  "engines": {
    "node": ">=18"
  }
}
